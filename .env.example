APP_ENV=development
APP_HOST=127.0.0.1
SALES_BOT_API_PORT=8001
LOG_LEVEL=INFO
DEBUG_PANEL_ENABLED=false

# Supabase Shared Pooler (session mode, port 5432). Parolu URL-encode edib placeholder-i dəyişin.
DATABASE_URL=postgresql+psycopg://postgres.xgwbakkmnykmujeutnhs:YOUR_PASSWORD_URL_ENCODED@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Integration testləri üçün əsas Supabase database-dən ayrı, adı _test ilə bitən database istifadə edin.
# TEST_DATABASE_URL=postgresql+psycopg://postgres.xgwbakkmnykmujeutnhs:YOUR_TEST_PASSWORD_URL_ENCODED@aws-0-ap-northeast-2.pooler.supabase.com:5432/ecommerce_assistant_test?sslmode=require

# Azure həm bot cavabları, həm də embedding üçün istifadə olunur. Model adları Azure deployment adlarıdır.
# Real endpoint və API açarını yalnız Git-ə düşməyən .env faylına yazın.
CUSTOMER_AZURE_OPENAI_ENDPOINT=YOUR_AZURE_ENDPOINT
CUSTOMER_AZURE_OPENAI_API_KEY=YOUR_AZURE_API_KEY
AZURE_TEXT_MODEL=gpt-5.4-mini
AZURE_EMBEDDING_MODEL=text-embedding-3-large

# Qdrant Cloud məlumatlarını yalnız .env faylında saxlayın.
QDRANT_URL=YOUR_QDRANT_CLOUD_URL
QDRANT_API_KEY=YOUR_QDRANT_API_KEY
QDRANT_COLLECTION_NAME=sales_bot_products_active
# Cari dataset/embedding eval nəticələrinə əsaslanan alternativ relevance həddi.
ALTERNATIVE_MIN_SCORE=0.39
ENTITY_RESOLUTION_MIN_SCORE=0.62
ENTITY_RESOLUTION_MARGIN=0.06

# Markdown document RAG yalnız sənədlər indekslənib baseline yaradıldıqdan sonra aktiv edilməlidir.
DOCUMENT_SEARCH_ENABLED=false
DOCUMENTS_PATH=data/documents/source
QDRANT_DOCUMENT_COLLECTION_NAME=sales_bot_documents_v1

PRODUCT_CATALOG_PATH=data/catalog/products.jsonl
MODE_NAME=ecommerce_assistant_v1
REASONING_EFFORT=low
MAX_TOOL_COUNT=3
MAX_MODEL_ROUNDS=4
MAX_OUTPUT_TOKENS=800
HISTORY_MESSAGE_LIMIT=12
SESSION_TTL_HOURS=168
SESSION_CONTEXT_SCRUB_INTERVAL_SECONDS=900
SESSION_MEMORY_CONTEXT_ENABLED=true
SESSION_MEMORY_MAX_BYTES=8192
MODULAR_PROMPT_ENABLED=true
# Development/test default. Keep false during the initial production shadow rollout.
DIRECTIONAL_RANKING_ENABLED=true
LLM_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=10
