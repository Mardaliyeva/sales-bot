APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Supabase Shared Pooler (session mode, port 5432). Parolu URL-encode edib placeholder-i dəyişin.
DATABASE_URL=postgresql://postgres.xgwbakkmnykmujeutnhs:[Your_Password]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Integration testləri üçün əsas Supabase database-dən ayrı, adı _test ilə bitən database istifadə edin.
# TEST_DATABASE_URL=postgresql+psycopg://postgres.xgwbakkmnykmujeutnhs:YOUR_TEST_PASSWORD_URL_ENCODED@aws-0-ap-northeast-2.pooler.supabase.com:5432/ecommerce_assistant_test?sslmode=require

OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-5.4-mini

# Azure yalnız embedding üçün istifadə olunur. Real dəyərləri Git-ə düşməyən .env faylına yazın.
CUSTOMER_AZURE_OPENAI_ENDPOINT=YOUR_AZURE_ENDPOINT
CUSTOMER_AZURE_OPENAI_API_KEY=YOUR_AZURE_API_KEY
AZURE_TEXT_MODEL=gpt-5.4-mini
AZURE_EMBEDDING_MODEL=text-embedding-3-large

# Qdrant Cloud məlumatlarını yalnız .env faylında saxlayın.
QDRANT_URL=YOUR_QDRANT_CLOUD_URL
QDRANT_API_KEY=YOUR_QDRANT_API_KEY
QDRANT_COLLECTION_NAME=sales_bot_products_v1

PRODUCT_CATALOG_PATH=data/catalog/products.jsonl
MODE_NAME=ecommerce_assistant_v1
REASONING_EFFORT=low
MAX_TOOL_COUNT=3
MAX_MODEL_ROUNDS=4
MAX_OUTPUT_TOKENS=800
HISTORY_MESSAGE_LIMIT=12
SESSION_TTL_HOURS=168
LLM_TIMEOUT_SECONDS=30
TOOL_TIMEOUT_SECONDS=10
